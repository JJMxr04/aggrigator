# Aggregator env. Copy to .env and edit. The .env file is loaded by
# ``aggrigator.config.Settings`` via pydantic-settings on startup.
#
# All keys here are read by the app — anything you set elsewhere (shell
# export, systemd EnvironmentFile, Railway env, k8s secret) is honored
# too. .env is the convention for local dev.
#
# Migrations: ``alembic upgrade head`` runs automatically inside the
# Railway web container via docker-entrypoint.sh — no manual step.
# Local dev: run ``./venv/bin/alembic upgrade head`` after pulling a
# branch with new revisions.

# --- core ---
AGG_ENV=dev
AGG_DEBUG=true
AGG_LOG_LEVEL=INFO

# Test mode — gates dangerous endpoints (data-reset, manual ingest-event).
# Default False so a fresh deployment is safe; flip to True ONLY for local
# dev / staging where wiping data is OK. NEVER True in production.
AGG_TEST_MODE=

# --- database ---
# Local dev default: Homebrew Postgres 18 on port 5434. Sync URL is used
# by Alembic; async URL is used by the app.
AGG_DATABASE_URL=postgresql+asyncpg://aggrigator:aggrigator@localhost:5434/aggrigator
AGG_DATABASE_URL_SYNC=postgresql+psycopg2://aggrigator:aggrigator@localhost:5434/aggrigator

# ============================================================================
# odds-api.io — sole odds/scores provider
# ============================================================================
# Base URL + bookmaker list are HARDCODED in aggrigator/ingest/odds_api_http.py
# (api.odds-api.io/v3; bet365 + pinnacle) by design. See
# aggrigator-plan/odds-api/best-practices.md §4.1 — even on paid tiers we
# stay at 2 books to keep request volume and pricing surface stable. Add
# a third only via code change + cost review.

# >>>>>> Drop your key here <<<<<<
ODDSAPI_API_KEY=

# Per-hour throttle: skip the auto cron when current usage hits this %
# of the live ``x-ratelimit-limit``. 80 = "skip at 80/100 req on free,
# 4000/5000 on paid Starter."
AGG_ODDSAPI_THROTTLE_PCT=80

# On HTTP 429, retry up to this many times with exponential backoff
# (honors Retry-After header). 0 = no retries (fail fast).
AGG_ODDSAPI_MAX_RETRIES=3

# --- auth ---
# Generate a real value with: ``openssl rand -hex 32``
AGG_JWT_SECRET=change-me-64-bytes-in-prod
# Independent secret for SessionMiddleware (admin/ops session cookies).
# Empty → falls back to AGG_JWT_SECRET with a startup warning. Set in
# prod so JWT and session can be rotated independently.
AGG_SESSION_SECRET=
AGG_JWT_ACCESS_TTL_SECONDS=900
AGG_JWT_REFRESH_TTL_SECONDS=1209600

# --- outbound webhook (aggrigator → MDProject) ---
# Where the aggrigator POSTs event/market/selection envelopes. Empty
# default so dev boots without one; the dispatcher logs and skips
# delivery if unset. Prod: point at MDProject's /sportgameodds/webhook.
AGG_WEBHOOK_TARGET_URL=http://localhost:8000/sportgameodds/webhook
# HMAC-SHA256 secret shared with MDProject's AGGRIGATOR_WEBHOOK_SECRET.
# Used by aggrigator/security/webhook_signing.sign() at delivery time.
# Generate with: openssl rand -hex 32 (same value on both sides).
AGG_WEBHOOK_SECRET=

# --- inbound internal API (MDProject → aggrigator, "Paradise" channel) ---
# HMAC secret for /v1/internal/* (user provisioning + entitlement sync).
# Same value as MDProject's PARADISE_SECRET. NEVER reuse
# AGG_WEBHOOK_SECRET — they sign opposite directions and a leak on one
# should not compromise the other. Generate with: openssl rand -hex 32.
# NOT YET WIRED IN CODE — planned in subscription-plan/04-internal-api.md.
AGG_PARADISE_SECRET=

# --- CORS / host allowlist ---
AGG_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Empty = TrustedHostMiddleware skipped (dev). In prod set to the exact
# hostnames the service answers on:
#   AGG_ALLOWED_HOSTS=aggrigator-production.up.railway.app,api.example.com
AGG_ALLOWED_HOSTS=

# FastAPI auto-docs (/docs /redoc /openapi.json). OFF BY DEFAULT — they
# expose the full route + schema graph (recon material for unauthenticated
# probes). Flip to true ONLY for short-lived dev/test environments.
AGG_DOCS_ENABLED=false

# ============================================================================
# Cadence
# ============================================================================
# All cron times are hardcoded in aggrigator/workers/settings.py. To change
# a schedule, edit that file and redeploy. (Cadence is product policy, not
# an env knob.)

# ============================================================================
# Ingest window
# ============================================================================

# ingest_due_leagues walks events whose start_time falls in
# [now - days_behind, now + days_ahead]. The "behind" buffer catches live
# events (started in the past) + just-finished games still flowing
# through settle.
AGG_INGEST_WINDOW_DAYS_AHEAD=7
AGG_INGEST_WINDOW_DAYS_BEHIND=2

# ============================================================================
# Response-shape trim
# ============================================================================
# Honored only if a future provider client wires them in. The current
# odds-api client uses its own hardcoded shape — these are no-ops there.

# Include every alt spread/total. Default off — bloats rows we don't read.
AGG_INGEST_INCLUDE_ALT_LINES=false

# Comma-separated oddID list to restrict /events responses. Empty = all.
# Example: AGG_INGEST_ODD_IDS=points-game-ml-home,points-game-ml-away
AGG_INGEST_ODD_IDS=

# Bookmaker ID(s), CSV. Empty = all. NOTE: the odds-api client ignores
# this — its bookmaker list is hardcoded (see odds-api section above).
AGG_INGEST_BOOKMAKER_ID=

# True (default) drops events whose first sighting is terminal
# (finished / postponed / canceled) and we've never seen them before.
# Avoids backfilling ancient games. Flip to false for one cron run after
# wiping the DB so today's already-finished games actually get inserted.
AGG_INGEST_SKIP_NEW_TERMINAL=true

# ============================================================================
# Vacuum (storage tuning)
# ============================================================================

# Delete terminal events older than this many days. Nightly @ 04:00 UTC.
# 3 = safe for free Neon (0.5 GB) with a window for late settlements.
AGG_VACUUM_DAYS=3


# Max events deleted per cron run. Cascades through markets / selections /
# quotes / webhook_delivery via DB FKs, so the actual row count touched is
# much higher. A backlog drains over multiple cron fires.
AGG_VACUUM_BATCH_SIZE=1000

# ============================================================================
# Lifecycle watchdog
# ============================================================================

# --- Stale-pending clock ---
# Events past start_time still in ``notstarted`` / ``inprogress`` are
# "stale" — typically a postponed game the upstream never updated.
AGG_LIFECYCLE_STALE_GRACE_HOURS=12
# > 0 = presumptively VOID stale events past this threshold. 0 disables.
AGG_LIFECYCLE_AUTO_VOID_HOURS=0

# --- Disappearance clock ---
# odds-api.io has no explicit ``cancelled`` status (verified vs OpenAPI).
# The disappearance signal is absence: an event stops appearing in
# /events. Independent of start_time so a pre-match cancellation 6h
# before kickoff is catchable. See cancelled-suspended.md §3 Layer 2.
AGG_LIFECYCLE_DISAPPEARED_GRACE_HOURS=6
AGG_LIFECYCLE_DISAPPEARED_VOID_HOURS=12

THE_ODDS_API_COM_KEY=
ANALYTICS_FREE_FOR_ALL=1
AGG_PROFILER_ENABLED=True
AGG_PROFILER_TOKEN=