{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aggrigator: API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/bin/python",
      "module": "uvicorn",
      "args": [
        "aggrigator.main:app",
        "--reload",
        "--host", "0.0.0.0",
        "--port", "8001"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Aggrigator: Worker (ARQ)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/bin/python",
      "module": "arq",
      "args": ["aggrigator.workers.settings.WorkerSettings"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Aggrigator: Pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/bin/python",
      "module": "pytest",
      "args": ["${file}", "-vv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Aggrigator: Pytest (full suite)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/bin/python",
      "module": "pytest",
      "args": ["tests", "-vv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Aggrigator: Alembic upgrade head",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/venv/bin/python",
      "module": "alembic",
      "args": ["upgrade", "head"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Aggrigator: API + Worker",
      "configurations": ["Aggrigator: API (uvicorn)", "Aggrigator: Worker (ARQ)"],
      "stopAll": true
    }
  ]
}
