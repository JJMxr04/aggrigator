{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Aggrigator: Setup venv",
      "type": "shell",
      "command": "python3.12 -m venv venv && ./venv/bin/pip install -U pip && ./venv/bin/pip install -e \".[dev]\"",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Aggrigator: Pytest",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/pytest",
      "args": ["-vv"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Aggrigator: API (uvicorn)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/uvicorn",
      "args": ["aggrigator.main:app", "--reload", "--host", "0.0.0.0", "--port", "8001"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^.*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Uvicorn running.*",
          "endsPattern": "^.*Shutdown complete.*"
        }
      },
      "presentation": { "reveal": "always", "panel": "shared", "group": "servers" }
    },
    {
      "label": "Aggrigator: Worker (ARQ)",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/arq",
      "args": ["aggrigator.workers.settings.WorkerSettings"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "group": "servers" }
    },
    {
      "label": "Aggrigator: Alembic upgrade head",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/alembic",
      "args": ["upgrade", "head"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "Aggrigator: Compose up (postgres+redis)",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "-d", "postgres", "redis"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
