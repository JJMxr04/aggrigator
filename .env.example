# --- core ---
AGG_ENV=dev
AGG_DEBUG=true
AGG_LOG_LEVEL=INFO

# --- database ---
# Local dev default: Homebrew Postgres 18 listening on port 5434 (set via
# postgresql.conf; see README). Sync URL is used by Alembic; async URL is used
# by the app.
AGG_DATABASE_URL=postgresql+asyncpg://aggrigator:aggrigator@localhost:5434/aggrigator
AGG_DATABASE_URL_SYNC=postgresql+psycopg2://aggrigator:aggrigator@localhost:5434/aggrigator

# --- redis (workers, rate limiter, future cache) ---
# Homebrew default port. The bundled docker-compose uses 6380 to coexist.
AGG_REDIS_URL=redis://localhost:6379/0

# --- SportsGameOdds ---
# Dev default points at the local simulator with a shared dev key. Both
# sides (aggregator + simulator) ship with ``aggrigator-dev`` baked in, so
# seed/ingest just work without per-side env vars.
#
# In production, set both — they MUST match real SGO:
#   SPORTSGAMEODDS_BASE_URL=https://api.sportsgameodds.com/v2
#   SPORTSGAMEODDS_API_KEY=<the real key>
SPORTSGAMEODDS_BASE_URL=http://127.0.0.1:8765/v2
SPORTSGAMEODDS_API_KEY=aggrigator-dev
# Or run fully offline against captured fixtures (no HTTP, no simulator):
# SPORTSGAMEODDS_FIXTURE_DIR=/Users/joem/dev/PBL/sports-scores-sim/json/sports_game/simulator

# --- auth ---
AGG_JWT_SECRET=change-me-64-bytes-in-prod
AGG_JWT_ACCESS_TTL_SECONDS=900
AGG_JWT_REFRESH_TTL_SECONDS=1209600

# --- CORS ---
AGG_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- observability ---
AGG_SENTRY_DSN=
