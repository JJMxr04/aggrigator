# Aggregator env. Copy to .env and edit. Loaded by
# ``aggrigator.config.Settings`` via pydantic-settings on startup.

# --- core ---
AGG_ENV=dev
AGG_DEBUG=true
AGG_LOG_LEVEL=INFO

# Gates dangerous endpoints (data-reset, manual ingest-event). NEVER True in prod.
AGG_TEST_MODE=true

# --- database (Homebrew Postgres 18, port 5434 by default) ---
AGG_DATABASE_URL=postgresql+asyncpg://aggrigator:aggrigator@localhost:5434/aggrigator
AGG_DATABASE_URL_SYNC=postgresql+psycopg2://aggrigator:aggrigator@localhost:5434/aggrigator

# --- odds-api.io (sole live odds/scores provider) ---
ODDSAPI_API_KEY=
# Skip the auto cron at this % of the live x-ratelimit-limit. 80 = "skip at
# 80/100 req on free, 4000/5000 on paid Starter."
AGG_ODDSAPI_THROTTLE_PCT=80
# On 429, retry up to N times with exponential backoff (honors Retry-After).
AGG_ODDSAPI_MAX_RETRIES=3

# --- TheSportsDB (historical scores) ---
# "3" is the free public key; paid keys unlock v2 + higher rate limits.
THESPORTSDB_API_KEY=3

# --- auth (generate with: openssl rand -hex 32) ---
AGG_JWT_SECRET=change-me-64-bytes-in-prod
# Empty → dev-only fallback to the JWT secret. PROD REFUSES TO BOOT when this
# is empty or equal to AGG_JWT_SECRET — set a distinct value before deploying.
AGG_SESSION_SECRET=

# --- service-tenant cutover (roadmap Phase 2) ---
# external_user_id (UUID) of THE service tenant. When set, the key belonging
# to that tenant may assert X-Acting-User on per-user-data routes (bets).
# Empty = per-user keys only, no assertions.
AGG_SERVICE_TENANT_EXTERNAL_ID=
# Keyed-reads rollout: false = keyless reads pass with a WARNING each (watch
# the logs); flip true only after MDProject attaches the service key and the
# warnings hit zero. Present keys are validated either way.
AGG_REQUIRE_KEY_FOR_READS=false

# --- proxy topology ---
# True when TLS terminates upstream (Cloudflare tunnel) and Traefik hands the
# app plain http: forces scheme=https so absolute URLs (sqladmin redirects)
# don't downgrade. The FastAPI twin of Django's SECURE_PROXY_SSL_HEADER.
# Set true in prod; leave false for plain-http local dev.
AGG_FORCE_HTTPS=false

# --- observability ---
# Bearer token for /metrics. Empty = open (prod logs a boot warning).
# Mismatch returns 404. Configure the Prometheus scraper with the same value.
AGG_METRICS_TOKEN=

# --- rate limiting ---
# Storage URL for the limiter. Empty → in-process memory (dev/tests only).
# Prod must use the shared Redis resource: with 4 uvicorn workers, memory
# counters allow 4x every limit. e.g. redis://default:pass@redis:6379
AGG_RATELIMIT_STORAGE_URL=
# Master switch — leave true; false exists for debugging only.
AGG_RATELIMIT_ENABLED=true
AGG_JWT_ACCESS_TTL_SECONDS=900
AGG_JWT_REFRESH_TTL_SECONDS=1209600

# --- outbound webhook (aggrigator → MDProject) ---
# Where the aggrigator POSTs event envelopes. Empty → dispatcher logs and skips.
AGG_WEBHOOK_TARGET_URL=
# HMAC secret. Same value as MDProject's AGGRIGATOR_WEBHOOK_SECRET.
AGG_WEBHOOK_SECRET=

# --- inbound internal API (MDProject → aggrigator, "Paradise") ---
# HMAC for /v1/internal/*. Same value as MDProject's PARADISE_SECRET.
# NEVER reuse AGG_WEBHOOK_SECRET — opposite directions, separate trust.
AGG_PARADISE_SECRET=

# --- platform kill-switch (paired with MDProject's ANALYTICS_FREE_FOR_ALL) ---
# 1 = require_pro_user authenticates the key but skips the PRO-tier check.
# Lets FREE-tier users reach /v1/analytics/* during a free window.
ANALYTICS_FREE_FOR_ALL=0

# --- CORS / hosts ---
AGG_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Empty = TrustedHostMiddleware skipped (dev). Prod: set exact hostname(s).
AGG_ALLOWED_HOSTS=

# /docs /redoc /openapi.json. OFF in prod — they leak the route + schema graph.
AGG_DOCS_ENABLED=false

# --- error tracking (GlitchTip via sentry-sdk) ---
# DSN from the GlitchTip `aggrigator` project. Empty = sentry disabled
# (local dev default). Web and worker share the same DSN; environment is
# taken from AGG_ENV, release from the Coolify SOURCE_COMMIT build arg.
AGG_SENTRY_DSN=

# --- ingest window (storage + quota tuning) ---
# Walks events whose start_time is in [now - days_behind, now + days_ahead].
AGG_INGEST_WINDOW_DAYS_AHEAD=7
AGG_INGEST_WINDOW_DAYS_BEHIND=2

# True (default) drops events whose first sighting is terminal (finished /
# postponed / canceled). Flip False for one cron run after wiping the DB.
AGG_INGEST_SKIP_NEW_TERMINAL=true

# --- vacuum (nightly @ 04:00 UTC) ---
# Delete terminal events older than this. 0 disables. 3 = safe for free Neon (0.5 GB).
AGG_VACUUM_DAYS=3
AGG_VACUUM_BATCH_SIZE=1000

# --- lifecycle watchdog ---
# Stale = past start_time but still notstarted/inprogress (postponed game upstream forgot).
AGG_LIFECYCLE_STALE_GRACE_HOURS=12
# > 0 = auto-VOID after N hours. 0 = informational only.
AGG_LIFECYCLE_AUTO_VOID_HOURS=0

# odds-api.io has no explicit ``cancelled`` — disappearance from /events is
# the signal. Independent of start_time so pre-match cancellations are catchable.
AGG_LIFECYCLE_DISAPPEARED_GRACE_HOURS=6
AGG_LIFECYCLE_DISAPPEARED_VOID_HOURS=12
