# Secrets — the glob (not just `.env.*`) also catches strays like
# ".env copy" that a dotted pattern misses.
.env
.env*
!.env.example

# Virtual environments
venv/
env/
.venv/
ENV/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / type / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Packaging
*.egg-info/
build/
dist/

# Alembic local state — schema lives in versions/, not in any DB-side cache
*.sqlite3

# OS junk
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo

# AI-generated plans/specs live in /Users/joem/dev/PBL/plans/aggrigator, not in-repo
docs/superpowers/
